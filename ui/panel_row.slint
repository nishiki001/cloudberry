import { Menus } from "menus_state.slint";
import { Theme } from "theme.slint";
import { ContextMenu } from "context_menu.slint";
import { Icon } from "icon.slint";

// Two-line row used by the sidebar lists (search results, library pages). Thumbnail when one
// has loaded, otherwise a kind icon. Draggable into the playlist table.
export component PanelRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> kind: "song";
    in property <image> thumb;
    in property <bool> has-thumb: false;
    in property <bool> selected: false;
    in property <bool> playing: false;
    /// "<list>:<index>" payload for drag & drop (empty = not draggable)
    in property <string> drag-data;
    callback clicked();
    /// Drag in progress: payload, title and window-absolute pointer position.
    callback drag-moved(string, string, length, length);
    callback drag-ended(string, length, length);
    callback activated();
    callback context(string);
    height: 42px;
    background: root.selected ? @linear-gradient(180deg, Theme.sel-top 0%, Theme.sel-bottom 100%) : ta.has-hover ? Theme.selection.with-alpha(0.5) : transparent;

    property <string> icon: root.kind == "album" ? "now" : root.kind == "artist" ? "user" : root.kind == "playlist" ? "lists" : "music";

    property <bool> dragging: false;
    Rectangle {
        HorizontalLayout {
            padding-left: 8px; padding-right: 8px; spacing: 8px;
            Rectangle {
                width: 32px;
                if root.has-thumb: Image { source: root.thumb; width: 30px; height: 30px; x: 1px; y: (parent.height - 30px) / 2; image-fit: cover; }
                if !root.has-thumb: Rectangle {
                    width: 30px; height: 30px; x: 1px; y: (parent.height - 30px) / 2;
                    background: Theme.analyzer-bg; border-width: 1px; border-color: Theme.border;
                    Icon { name: root.icon; size: 16px; tint: Theme.text-dim; x: 7px; y: 7px; }
                }
                if root.playing: Icon { name: "play"; size: 14px; tint: Theme.accent-text; x: 17px; y: 24px; }
            }
            VerticalLayout {
                alignment: center; spacing: 1px;
                Text { text: root.title; color: Theme.text; font-weight: root.playing ? 700 : 400; overflow: elide; }
                Text { text: root.subtitle; color: Theme.text-dim; font-size: 11px * Theme.font-scale; overflow: elide; }
            }
        }
        ta := TouchArea {
            clicked => { root.clicked(); }
            double-clicked => { root.activated(); }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) { root.open-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.dragging) {
                    root.dragging = false;
                    root.drag-ended(root.drag-data, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
                if (e.kind == PointerEventKind.cancel) { root.dragging = false; }
            }
            moved => {
                if (self.pressed && root.drag-data != "" && (Math.abs(self.mouse-x - self.pressed-x) > 8px || Math.abs(self.mouse-y - self.pressed-y) > 8px)) {
                    root.dragging = true;
                    root.drag-moved(root.drag-data, root.title, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }
    // the menu lives in the window-level host, not in this (recreatable) row
    in property <string> menu-owner;
    in property <int> menu-index;
    property <int> picked: ContextMenu.picked-serial;
    changed picked => {
        if (root.menu-owner != "" && ContextMenu.picked-owner == root.menu-owner && ContextMenu.picked-index == root.menu-index) { root.context(ContextMenu.picked-id); }
    }
    function open-menu(x: length, y: length) {
        ContextMenu.show(root.menu-owner, root.menu-index, Menus.track-items(root.drag-data != "", false, []), x, y);
    }
}
