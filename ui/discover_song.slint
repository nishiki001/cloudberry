import { ContextMenu } from "context_menu.slint";
import { Theme } from "theme.slint";
import { CardData } from "types.slint";
import { Menus } from "menus_state.slint";
import { Icon } from "icon.slint";

// One row of a compact song list (Quick picks…): thumbnail, title, artist; double use of the
// playlist row style.
export component DiscoverSong inherits Rectangle {
    in property <CardData> card;
    callback clicked();
    /// The menu lives in the window-level host; the shelf receives the choice (see context_menu.slint).
    in property <string> menu-owner;
    in property <int> menu-index;
    callback shown();
    init => { root.shown(); }
    width: 300px;
    height: 44px;
    background: ta.has-hover ? Theme.selection.with-alpha(0.5) : transparent;
    border-radius: 3px;
    Rectangle {
        x: 6px; y: 6px; width: 32px; height: 32px; border-radius: 3px; clip: true;
        background: Theme.analyzer-bg;
        if root.card.has-thumb: Image { source: root.card.thumb; width: parent.width; height: parent.height; image-fit: cover; }
        if !root.card.has-thumb: Icon { name: "music"; size: 16px; tint: Theme.text-dim; x: 8px; y: 8px; }
    }
    Text { x: 46px; y: 5px; width: parent.width - 52px; height: 18px; text: root.card.title; color: Theme.text; overflow: elide; vertical-alignment: center; }
    Text { x: 46px; y: 23px; width: parent.width - 52px; height: 16px; text: root.card.subtitle; color: Theme.text-dim; font-size: 12px * Theme.font-scale; overflow: elide; vertical-alignment: center; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) { ContextMenu.show(root.menu-owner, root.menu-index, Menus.track-items(true, false, []), self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
    }
}
