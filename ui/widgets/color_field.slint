import { Theme } from "../theme.slint";
import { ColorMath } from "../color_math.slint";
import { ColorPicker } from "color_picker.slint";

// A colour setting: swatch + hex text, click the swatch to open the picker. Edits are live;
// Cancel in the picker puts the previous value back. An empty value means "system / default"
// and shows `fallback`.
export component ColorField inherits Rectangle {
    in-out property <string> value;
    in property <color> fallback: Theme.accent;
    in property <string> placeholder: "system";
    callback edited(string);
    property <string> original;
    height: 24px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    background: Theme.base;

    swatch := Rectangle {
        x: 4px; y: 4px; width: 24px; height: 16px;
        background: root.value == "" ? root.fallback : ColorMath.to-color(root.value);
        border-width: 1px; border-color: Theme.border; border-radius: 2px;
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.original = root.value;
                popup.show();
            }
        }
    }
    input := TextInput {
        x: 36px; width: parent.width - 44px;
        vertical-alignment: center;
        color: Theme.text; font-size: 12px * Theme.font-scale; single-line: true;
        text <=> root.value;
        selection-background-color: Theme.selection;
        selection-foreground-color: Theme.text;
        edited => { root.edited(self.text); }
    }
    if root.value == "" && !input.has-focus: Text {
        x: 36px; text: root.placeholder; color: Theme.text-dim; font-size: 12px * Theme.font-scale;
        vertical-alignment: center; height: parent.height;
    }
    popup := PopupWindow {
        x: 0px; y: root.height + 4px;
        close-policy: no-auto-close;
        width: picker.width; height: picker.height;
        picker := ColorPicker {
            x: 0px; y: 0px;
            initial: root.value; initial-color: root.fallback;
            live(c) => { root.value = c; root.edited(c); }
            accepted(c) => { root.value = c; root.edited(c); popup.close(); }
            cancelled => { root.value = root.original; root.edited(root.original); popup.close(); }
        }
    }
}
