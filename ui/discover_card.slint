import { ContextMenu } from "context_menu.slint";
import { Theme } from "theme.slint";
import { CardData } from "types.slint";
import { Menus } from "menus_state.slint";
import { Icon } from "icon.slint";

// A Discover card: 140 px cover, title and subtitle (elided), a round play button on hover.
export component DiscoverCard inherits Rectangle {
    in property <CardData> card;
    callback clicked();
    callback play();
    /// The menu lives in the window-level host; the shelf receives the choice (see context_menu.slint).
    in property <string> menu-owner;
    in property <int> menu-index;
    /// Reported once when the card is created (it exists only while visible): load its cover.
    callback shown();
    init => { root.shown(); }
    width: 140px;
    height: 200px;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) { ContextMenu.show(root.menu-owner, root.menu-index, Menus.track-items(root.card.kind == "song" || root.card.kind == "video", false, []), self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
    }
    Rectangle { // cover
        x: 0px; y: 0px; width: 140px; height: 140px;
        border-radius: root.card.kind == "artist" ? 70px : 4px;
        clip: true;
        background: Theme.analyzer-bg;
        border-width: 1px; border-color: Theme.border;
        if root.card.has-thumb: Image { source: root.card.thumb; width: parent.width; height: parent.height; image-fit: cover; }
        if !root.card.has-thumb: Icon {
            name: root.card.kind == "artist" ? "user" : "music"; size: 36px; tint: Theme.text-dim;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        }
    }
    // hover: round play button (its hit zone is always there so the button does not flicker
    // when the pointer moves onto it)
    property <bool> hot: ta.has-hover || play-ta.has-hover;
    if root.hot: Rectangle {
        x: 140px - 48px; y: 140px - 48px; width: 40px; height: 40px; border-radius: 20px;
        background: play-ta.has-hover ? Theme.accent : Theme.accent.with-alpha(0.9);
        drop-shadow-color: Theme.shadow; drop-shadow-blur: 6px;
        Icon { name: "play"; size: 18px; tint: Theme.on-accent; x: 11px; y: 11px; }
    }
    play-ta := TouchArea { x: 140px - 48px; y: 140px - 48px; width: 40px; height: 40px; mouse-cursor: pointer; clicked => { root.play(); } }
    Text { x: 0px; y: 146px; width: 140px; height: 18px; text: root.card.title; color: Theme.text; font-size: 13px * Theme.font-scale; font-weight: 700; overflow: elide; }
    Text { x: 0px; y: 164px; width: 140px; height: 16px; text: root.card.subtitle; color: Theme.text-dim; font-size: 12px * Theme.font-scale; overflow: elide; }
}
