import { Menus } from "menus_state.slint";
import { ScrollList } from "scroll_list.slint";
import { Theme } from "theme.slint";
import { TrackData, TreeRow } from "types.slint";
import { PanelRow } from "panel_row.slint";
import { Button } from "button.slint";
import { Icon } from "icon.slint";
import { ContextMenu } from "context_menu.slint";

// Library tab. Home view: an expandable tree (Liked songs · Playlists · Albums · Artists ·
// History), children load lazily on first expand. Page view (artist / album / playlist pages
// reached from "Go to…"): a flat list with Back, Play all, Shuffle.
export component PanelLibrary inherits Rectangle {
    in property <[TreeRow]> tree;
    in property <[TrackData]> library;
    in property <string> mode: "menu"; // menu = tree; artist album playlist playlists liked history = page
    in property <string> title;
    in-out property <int> selected: -1;
    callback tree-clicked(int);
    callback tree-activated(int);
    callback tree-context(string, int);
    callback back();
    callback play-all();
    callback shuffle-all();
    callback activate(int);
    callback context(string, int);
    callback drag-moved(string, string, length, length);
    callback drag-ended(string, length, length);
    background: Theme.base;

    if root.mode == "menu": tree-list := ScrollList {
        row-h: 40px; count: root.tree.length;
        for k in tree-list.shown: Rectangle {
            property <int> i: tree-list.first + k;
            property <TreeRow> r: root.tree[i];
            visible: i < root.tree.length;
            x: 0px; y: i * 40px; width: tree-list.width - 12px;
            height: 40px;
            background: i == root.selected ? @linear-gradient(180deg, Theme.sel-top 0%, Theme.sel-bottom 100%) : ta.has-hover ? Theme.selection.with-alpha(0.5) : transparent;
            if r.kind == "section": Rectangle {
                Icon { name: r.expanded ? "down" : "forward"; size: 14px; tint: Theme.text-dim; x: 6px; y: (parent.height - self.height) / 2; }
                Text { x: 26px; width: parent.width - 34px; text: r.label + (r.loading ? "  …" : ""); color: Theme.text; font-weight: 700; vertical-alignment: center; height: parent.height; overflow: elide; }
            }
            if r.kind != "section": HorizontalLayout {
                padding-left: 26px; padding-right: 8px; spacing: 8px;
                Rectangle {
                    width: 30px;
                    if r.has-thumb: Image { source: r.thumb; width: 28px; height: 28px; y: (parent.height - 28px) / 2; image-fit: cover; }
                    if !r.has-thumb: Rectangle {
                        width: 28px; height: 28px; y: (parent.height - 28px) / 2;
                        background: Theme.analyzer-bg; border-width: 1px; border-color: Theme.border;
                        Icon { name: r.kind == "album" ? "now" : r.kind == "artist" ? "user" : r.kind == "playlist" ? "lists" : "music"; size: 15px; tint: Theme.text-dim; x: 6px; y: 6px; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: r.label; color: Theme.text; overflow: elide; font-weight: r.playing ? 700 : 400; }
                    Text { text: r.sub; color: Theme.text-dim; font-size: 11px * Theme.font-scale; overflow: elide; }
                }
            }
            ta := TouchArea {
                clicked => { root.selected = i; root.tree-clicked(i); }
                double-clicked => { root.tree-activated(i); }
                pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up && r.kind != "section") { ContextMenu.show("tree", i, Menus.track-items(r.kind == "song" || r.kind == "video", false, []), self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
            }
            property <int> picked: ContextMenu.picked-serial;
            changed picked => {
                if (ContextMenu.picked-owner == "tree" && ContextMenu.picked-index == i) { root.tree-context(ContextMenu.picked-id, i); }
            }
        }
    }
    if root.mode != "menu": VerticalLayout {
        HorizontalLayout {
            padding: 6px; spacing: 6px;
            Button { label: "Back"; clicked => { root.back(); } }
            Text { text: root.title; color: Theme.text-dim; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        }
        if root.mode != "playlists" && root.mode != "artist": HorizontalLayout {
            padding-left: 6px; padding-right: 6px; spacing: 6px;
            Button { label: "Play all"; clicked => { root.play-all(); } }
            Button { label: "Shuffle"; clicked => { root.shuffle-all(); } }
        }
        plist := ScrollList {
            vertical-stretch: 1;
            row-h: 42px; count: root.library.length;
            for k in plist.shown: PanelRow {
                property <int> i: plist.first + k;
                property <TrackData> t: root.library[i];
                visible: i < root.library.length;
                x: 0px; y: i * 42px; width: plist.width - 12px;
                menu-owner: "library-page"; menu-index: i;
                title: t.title; subtitle: t.artist + (t.time != "" ? " · " + t.time : "");
                kind: t.kind; thumb: t.thumb; has-thumb: t.has-thumb;
                playing: t.playing;
                selected: i == root.selected;
                drag-data: t.kind == "song" || t.kind == "video" ? "library:" + i : "";
                clicked => { root.selected = i; }
                activated => { root.activate(i); }
                context(a) => { root.context(a, i); }
                drag-moved(d, ti, x, y) => { root.drag-moved(d, ti, x, y); }
                drag-ended(d, x, y) => { root.drag-ended(d, x, y); }
            }
        }
    }
}
