# Maintainer: nishiki001 <nishiki001@users.noreply.github.com>
pkgname=cloudberry-bin
_name=cloudberry
pkgver=0.1.0
pkgrel=1
pkgdesc='Unofficial desktop client for YouTube Music (not affiliated with Google), prebuilt'
arch=('x86_64' 'aarch64')
url='https://github.com/nishiki001/cloudberry'
license=('GPL-3.0-or-later')
depends=('alsa-lib' 'fontconfig' 'libxkbcommon')
optdepends=('wayland: Wayland support' 'libxkbcommon-x11: X11 support')
provides=('cloudberry')
conflicts=('cloudberry')
source_x86_64=("$_name-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/cloudberry-linux-x86_64.tar.gz")
source_aarch64=("$_name-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/cloudberry-linux-aarch64.tar.gz")
# filled in by scripts/aur-update.sh from the release's SHA256SUMS
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  cd "$srcdir/$_name"
  cp -r --no-preserve=ownership usr "$pkgdir/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
